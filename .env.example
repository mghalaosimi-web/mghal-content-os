# ==========================================
# M.GH.AL Content OS - Environment Variables
# ==========================================

# Application Environment
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_NAME="M.GH.AL Content Studio"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mghal_content_os?schema=public"

# AI Engine Configuration (Gemini API - Target for Phase M002)
# GEMINI_API_KEY=""

# Supported Social Platform Integration Credentials (M006)
# FACEBOOK (Meta Graph API)
# FACEBOOK_PAGE_ID="your_facebook_page_id"
# FACEBOOK_PAGE_ACCESS_TOKEN="your_page_access_token_with_pages_manage_posts"

# INSTAGRAM (Instagram Content Publishing API)
# INSTAGRAM_ACCOUNT_ID="your_instagram_business_account_id"
# INSTAGRAM_ACCESS_TOKEN="your_instagram_user_access_token"

# TIKTOK (TikTok Content Posting API)
# TIKTOK_ACCESS_TOKEN="your_tiktok_user_access_token"
# TIKTOK_CREATOR_ID="your_tiktok_open_id"

# Public image base URL (Required by Meta Graph API for Instagram image containers)
# PUBLIC_IMAGE_BASE_URL="https://your-public-domain-or-ngrok.io"

# Note: WhatsApp is strictly excluded from this project scope.

