# ==========================================
# M.GH.AL Content OS - Environment Variables
# ==========================================

# Application Environment
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_NAME="M.GH.AL Content Studio"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mghal_content_os?schema=public"

# AI Engine Configuration (Gemini API - Target for Phase M002)
# GEMINI_API_KEY=""

# Supported Social Platform Integration Toggles (Phase M006-M007)
# FACEBOOK_ENABLED=false
# INSTAGRAM_ENABLED=false
# TIKTOK_ENABLED=false
# Note: WhatsApp is strictly excluded from this project scope.
